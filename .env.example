# Copia este archivo como .env en la raíz (lo leen infra/compose.yml y el backend).
# Nunca subas el .env al repositorio.

# ---------- Infraestructura (Docker Compose) ----------
POSTGRES_USER=reclamos
POSTGRES_PASSWORD=reclamos_dev
POSTGRES_DB=reclamos

# ---------- Backend ----------
# Cadena de conexión SQLAlchemy (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://reclamos:reclamos_dev@127.0.0.1:5432/reclamos
VALKEY_URL=redis://127.0.0.1:6379/0

# dev: acepta el encabezado X-Dev-User: <email> | firebase: valida el ID token
AUTH_MODE=dev
# Solo en modo firebase: ruta al JSON de la cuenta de servicio (fuera del repositorio)
FIREBASE_CREDENTIALS_PATH=

# Horas desde la entrega en las que se acepta un reclamo
RECLAMO_PLAZO_HORAS=24
# Carpeta donde se guardan las fotos de los reclamos
UPLOAD_DIR=./uploads
# Tamaño máximo de la foto en bytes (5 MB)
FOTO_MAX_BYTES=5242880
# Orígenes permitidos por CORS, separados por comas (* en desarrollo)
CORS_ORIGINS=*
