# Copia este archivo como .env en la raíz (lo leen infra/compose.yml y el backend).
# Nunca subas el .env al repositorio.

# ---------- Infraestructura (Docker Compose) ----------
POSTGRES_USER=reclamos
POSTGRES_PASSWORD=reclamos_dev
POSTGRES_DB=reclamos

# ---------- Backend ----------
# Cadena de conexión SQLAlchemy (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://reclamos:reclamos_dev@127.0.0.1:5432/reclamos
VALKEY_URL=redis://127.0.0.1:6379/0

# dev: acepta el encabezado X-Dev-User: <email> | firebase: valida el ID token
AUTH_MODE=dev
# Solo en modo firebase: ruta al JSON de la cuenta de servicio (fuera del repositorio)
FIREBASE_CREDENTIALS_PATH=

# Horas desde la entrega en las que se acepta un reclamo
RECLAMO_PLAZO_HORAS=24
# Carpeta donde se guardan las fotos de los reclamos
UPLOAD_DIR=./uploads
# Tamaño máximo de la foto en bytes (5 MB)
FOTO_MAX_BYTES=5242880
# Orígenes permitidos por CORS, separados por comas (* en desarrollo)
CORS_ORIGINS=*

# ---------- Sistema de caja antiguo (SISCAJA) ----------
# Archivo SQLite (relativo a sistema-caja/)
CAJA_DB_PATH=./data/caja.db
# Firma la cookie de sesión; genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
# Si la dejas vacía se crea una al azar en cada arranque.
CAJA_SECRET_KEY=
# Operador que crea `flask --app caja init-db` (el bot RPA usa estas mismas credenciales)
CAJA_OPERADOR_USUARIO=cajero01
CAJA_OPERADOR_NOMBRE=Cajero de turno
CAJA_OPERADOR_CLAVE=cambia-esta-clave
# Base de ventas de donde `flask --app caja sincronizar` copia los pedidos (solo lectura).
# Si se deja comentada, usa DATABASE_URL.
# CAJA_VENTAS_DATABASE_URL=postgresql://reclamos:reclamos_dev@127.0.0.1:5432/reclamos

# ---------- Bot RPA ----------
# Usa CAJA_OPERADOR_USUARIO y CAJA_OPERADOR_CLAVE para iniciar sesión en SISCAJA.
BOT_CAJA_URL=http://127.0.0.1:5050
# Carpeta de cada ejecución: resultado.json, capturas/, video.webm (relativa a bot-rpa/)
BOT_SALIDAS_DIR=./salidas
# true: navegador visible y en cámara lenta (demo) | false: oculto (worker)
BOT_VISIBLE=false
# Pausa entre acciones en modo visible (milisegundos)
BOT_VELOCIDAD_MS=250
BOT_GRABAR_VIDEO=true
# Tiempo máximo de una ejecución (segundos)
BOT_TIMEOUT_S=180
