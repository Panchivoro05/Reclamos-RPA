# Copia este archivo como app-movil/.env (Expo lo lee al iniciar; reinicia con --clear si lo cambias).

# URL de la API vista DESDE EL CELULAR: usa la IP de tu PC en la red local, no localhost.
# Averíguala con: ip -4 addr show | grep inet
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# dev: login eligiendo un cliente demo (encabezado X-Dev-User) | firebase: correo y contraseña
EXPO_PUBLIC_AUTH_MODE=dev

# Solo en modo firebase (configuración web del proyecto en la consola de Firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
