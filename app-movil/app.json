{
  "expo": {
    "name": "BurgerYa Reclamos",
    "slug": "reclamos-rpa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.burgerya.reclamos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.burgerya.reclamos",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "BurgerYa usa tus fotos para adjuntarlas a tus reclamos.",
          "cameraPermission": "BurgerYa usa la cámara para que tomes una foto del producto en tu reclamo.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#DC4316",
          "defaultChannel": "reclamos"
        }
      ]
    ],
    "scheme": "burgerya",
    "extra": {
      "eas": {
        "projectId": "41328781-abec-4c56-98fe-f9b55a2c7f2f"
      }
    },
    "owner": "rofavicus-team"
  }
}
